# Copy this file to .env and fill in your values.
# .env is gitignored and should never be committed.

# Web UI authentication secret (required when ui.enabled is true in ebeacon.yaml)
# Used by the web UI for its own auth keys — distinct from the API auth keys.
# Generate a strong random value: openssl rand -hex 32
EBEACON_UI_SECRET=changeme

# Grafana admin credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme
