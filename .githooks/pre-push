#!/usr/bin/env bash
set -euo pipefail

echo "pre-push: gofmt verification..."
UNFORMATTED="$(gofmt -l $(rg --files -g '*.go'))"
if [[ -n "${UNFORMATTED}" ]]; then
  echo "pre-push: gofmt check failed for:"
  echo "${UNFORMATTED}"
  exit 1
fi

echo "pre-push: go vet..."
go vet ./...

echo "pre-push: race tests..."
go test -race ./...

echo "pre-push: golangci-lint..."
if command -v golangci-lint >/dev/null 2>&1; then
  golangci-lint run ./...
else
  echo "pre-push: golangci-lint not installed; skipping local lint."
  echo "          CI will still enforce golangci-lint."
fi

# Match CI's security job: run govulncheck against the Go version declared in
# go.mod so stdlib vulns are detected before push. Without GOTOOLCHAIN pinning,
# a developer on a newer local Go than go.mod declares will silently miss
# stdlib vulns that CI reports against the older toolchain.
echo "pre-push: govulncheck..."
GOTOOLCHAIN="go$(awk '/^go /{print $2; exit}' go.mod)" \
  go run golang.org/x/vuln/cmd/govulncheck@latest ./...

echo "pre-push: passed."
